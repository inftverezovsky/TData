{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "frontend/src/*"
      ],
      "@backend/*": [
        "backend/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../backend/src/**/*.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}

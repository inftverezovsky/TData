# PostgreSQL. docker-compose.yml below uses these defaults.
POSTGRES_USER=tdata
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tdata
POSTGRES_PORT=5434
DATABASE_URL="postgresql://tdata:change-me@localhost:5434/tdata?schema=public"

# Liquipedia Dota 2 MediaWiki API endpoint.
LIQUIPEDIA_DOTA2_API_URL="https://liquipedia.net/dota2/api.php"

# REQUIRED for real usage: identify your project and add contact information.
# Example: "liquipedia-local-dev/0.1 (https://example.com; your-email@example.com)"
LIQUIPEDIA_USER_AGENT="liquipedia-local-dev/0.1 (contact: change-me@example.com)"

# Manual app, but still rate-limited.
LIQUIPEDIA_GENERIC_MIN_INTERVAL_MS=2100
LIQUIPEDIA_PARSE_MIN_INTERVAL_MS=31000
LIQUIPEDIA_JITTER_MS=650
LIQUIPEDIA_COOLDOWN_MS=600000

# Reuse recent search results for the same query.
SEARCH_CACHE_TTL_SECONDS=86400
LIQUIPEDIA_SEARCH_VARIATION_LIMIT=5
LIQUIPEDIA_SEARCH_FULLTEXT_VARIATION_LIMIT=2
LIQUIPEDIA_SEARCH_TIME_BUDGET_MS=45000
LIQUIPEDIA_SEARCH_API_TIMEOUT_MS=7000
LIQUIPEDIA_SEARCH_API_MAX_RETRIES=0
LIQUIPEDIA_IMPORT_API_TIMEOUT_MS=12000
LIQUIPEDIA_IMPORT_API_MAX_RETRIES=0
# Try direct Liquipedia access once if the selected proxy times out.
LIQUIPEDIA_DIRECT_FALLBACK_ENABLED=1
# Skip the expensive action=parse API call (saves ~31s per page). Set to 0 to re-enable.
LIQUIPEDIA_SKIP_PARSED_HTML=1
# Number of sub-pages to fetch in parallel during tournament import.
LIQUIPEDIA_SUBPAGE_CONCURRENCY=3

# HLTV search uses Playwright through Proxy Pool.
HLTV_SEARCH_TIMEOUT_MS=30000
HLTV_SEARCH_RESULT_WAIT_MS=12000
HLTV_SEARCH_MAX_ATTEMPTS=1
HLTV_ALLOW_DIRECT_FALLBACK=1
HLTV_QUEUE_DELAY_MS=1000
# Optional newline/comma/semicolon-separated proxy URLs for automatic proxy pool seeding.
# Keep secrets in environment/DB only; never commit real proxy credentials.
PROXY_AUTO_SEED_URLS=

# VolleyballWorld global schedule request timeout (1-300000 ms, default 120 seconds).
VOLLEYBALL_WORLD_TIMEOUT_MS=120000

# Optional UI base URL.
NEXT_PUBLIC_APP_NAME="TData"
# Public origin used for JSON links that an external upload service must fetch.
# Example: http://82.147.67.231:3010
TDATA_PUBLIC_BASE_URL=

# Optional AI parser for manual imports. Keep the real key only in server/local environment.
ARCCODEX_API_KEY=

# Admin UI/API protection.
# In production, set both values. Without ADMIN_PASSWORD, DB setting admin_password is used if present.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Use true only when the app is served through HTTPS.
ADMIN_COOKIE_SECURE=true

# Optional comma-separated allowlist for sync target hosts.
EXTERNAL_PLATFORM_ALLOWED_HOSTS=
EXTERNAL_PLATFORM_ALLOW_INSECURE_HTTP=0

# Comma-separated allowlist for FIxt/Admin upload hosts. Recommended in production.
ADMIN_UPLOAD_ALLOWED_HOSTS=
ADMIN_UPLOAD_ALLOW_INSECURE_HTTP=0
ADMIN_UPLOAD_ALLOW_PRIVATE_HOSTS=0
ADMIN_UPLOAD_ALLOW_ANY_PUBLIC_HOST=0
ADMIN_AUTH_ALLOW_NONE=0

# Optional base URL for opening the external admin upload service.
ADMIN_SERVICE_URL=
NEXT_PUBLIC_ADMIN_SERVICE_URL=

# Optional secret for /api/cron/check-proxies. If empty, an admin session is required.
CRON_PROXY_CHECK_SECRET=

# Trust proxy headers only when the app is behind a reverse proxy you control.
TRUST_PROXY_HEADERS=0

# Admin Upload mTLS (Client Certificates)
ADMIN_MTLS_ENABLED=false

# PFX/P12 mode
ADMIN_MTLS_PFX_PATH=
ADMIN_MTLS_PFX_PASSPHRASE=
ADMIN_MTLS_PFX_BASE64=

# Cert/Key mode
ADMIN_MTLS_CERT_PATH=
ADMIN_MTLS_KEY_PATH=
ADMIN_MTLS_CA_PATH=
ADMIN_MTLS_PASSPHRASE=

ADMIN_MTLS_CERT_BASE64=
ADMIN_MTLS_KEY_BASE64=
ADMIN_MTLS_CA_BASE64=

# Admin Upload Auth
# Mode: none | basic | bearer | x-api-key
ADMIN_AUTH_MODE=none

# Basic Auth
ADMIN_BASIC_USERNAME=
ADMIN_BASIC_PASSWORD=

# Bearer Token
ADMIN_API_TOKEN=

# Custom Header (x-api-key mode)
ADMIN_API_KEY_HEADER=x-api-key
ADMIN_API_KEY_VALUE=

# Identity sync for team IDs, tournament shapka IDs, discipline sport IDs, and tournament platform IDs.
# Keep empty to disable. Set the same TDATA_SYNC_TOKEN on both instances.
TDATA_INSTANCE_ID=local
TDATA_SYNC_PEER_URL=
TDATA_SYNC_TOKEN=
TDATA_SYNC_TIMEOUT_MS=60000
# Disabled by default so local/server API URLs do not overwrite each other.
IDENTITY_SYNC_INCLUDE_API_URL=0

# Automatic KHL result collection. The host systemd timer is the actual scheduler.
KHL_RESULTS_AUTO_SYNC_ENABLED=1
KHL_RESULTS_AUTO_SYNC_INTERVAL_MINUTES=10

# TLine remains fail-closed until the read-only Admin contract and rollout settings are confirmed.
TLINE_ENABLED=0
TLINE_SCHEDULER_READY=0
# Supported today: http (fail-closed placeholder), fixture (development/test only).
TLINE_ADMIN_MODE=http
# Development/test only: path inside the container to a validated JSON fixture.
TLINE_ADMIN_FIXTURE_PATH=
# Optional immutable image tag used by both web and tline-worker in Compose.
TDATA_IMAGE=tdata-local

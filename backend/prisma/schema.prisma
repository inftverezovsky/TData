generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SearchStatus {
  SUCCESS
  FAILED
  CACHED
}

enum ImportStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
  MANUAL_REVIEW
}

model Discipline {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  baseApiUrl        String?
  platformId        String?
  isEnabled         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  searchRequests    SearchRequest[]
  tournamentImports TournamentImport[]
  tlineSportConfig  TLineSportConfig?
}

model SearchRequest {
  id           String         @id @default(cuid())
  disciplineId String
  discipline   Discipline     @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  queryText    String
  status       SearchStatus   @default(SUCCESS)
  createdAt    DateTime       @default(now())
  results      SearchResult[]

  @@index([disciplineId, queryText, createdAt])
}

model SearchResult {
  id              String        @id @default(cuid())
  searchRequestId String
  searchRequest   SearchRequest @relation(fields: [searchRequestId], references: [id], onDelete: Cascade)
  pageId          Int
  title           String
  pageUrl         String
  snippet         String?       @db.Text
  score           Float?
  wordCount       Int?
  dates           String?
  createdAt       DateTime      @default(now())

  @@index([pageId])
  @@index([title])
}

model TournamentImport {
  id           String        @id @default(cuid())
  disciplineId String
  discipline   Discipline    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  pageId       Int?
  pageTitle    String
  pageUrl      String
  status       ImportStatus  @default(PENDING)
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  errorMessage String?       @db.Text
  rawSnapshots RawSnapshot[]
  tournament   Tournament?   @relation("TournamentLastImport")

  @@index([disciplineId, startedAt])
  @@index([pageTitle])
}

model RawSnapshot {
  id                 String           @id @default(cuid())
  tournamentImportId String
  tournamentImport   TournamentImport @relation(fields: [tournamentImportId], references: [id], onDelete: Cascade)
  source             String
  disciplineSlug     String?
  pageId             Int?
  pageTitle          String
  contentHash        String?
  revisionId         Int?
  revisionTimestamp  DateTime?
  rawJson            Json
  rawWikitext        String?          @db.Text
  rawHtml            String?          @db.Text
  qualityScore       Float?
  metadata           Json?
  fetchedAt          DateTime         @default(now())

  @@index([disciplineSlug, pageTitle])
  @@index([pageTitle])
  @@index([fetchedAt])
  @@index([contentHash])
}

model Tournament {
  id               String                  @id @default(cuid())
  sourcePageId     Int?
  sourceTitle      String
  sourceUrl        String
  name             String
  disciplineSlug   String
  startDate        DateTime?
  endDate          DateTime?
  location         String?
  region           String?
  organizer        String?
  prizePool        String?
  formatText       String?                 @db.Text
  status           String?
  extractionStatus ImportStatus            @default(PARTIAL)
  normalization    Json?
  platformId       String?
  lastImportId     String?                 @unique
  lastImport       TournamentImport?       @relation("TournamentLastImport", fields: [lastImportId], references: [id])
  participants     TournamentParticipant[]
  matches          TournamentMatch[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([disciplineSlug, sourceTitle])
  @@index([disciplineSlug])
  @@index([sourcePageId])
  @@index([name])
  @@index([sourceUrl])
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  platformId   String?
  seed         String?
  region       String?
  status       String?
  logoUrl      String?
  rawText      String?    @db.Text
  createdAt    DateTime   @default(now())

  @@index([tournamentId])
  @@index([name])
}

model TournamentMatch {
  id                  String     @id @default(cuid())
  matchId             String     @unique
  tournamentId        String
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage               String?
  round               String?
  matchDate           DateTime?
  matchDateTime       String?
  teamAId             String?
  teamAName           String?
  teamBId             String?
  teamBName           String?
  scoreA              Int?
  scoreB              Int?
  format              String?
  status              String?
  court               String?
  sourceUrl           String?
  lpNumericalId       BigInt?    @unique
  platformId          String?
  syncedAt            DateTime?
  rawText             String?    @db.Text
  hasPlaceholderTeams Boolean    @default(false)
  sourceConfidence    Float?
  sourceBreakdown     Json?
  createdAt           DateTime   @default(now())

  @@index([tournamentId])
  @@index([matchDate])
  @@index([platformId])
}

model SourceFetchCache {
  id                String    @id @default(cuid())
  source            String
  disciplineSlug    String    @default("global")
  resourceType      String
  resourceKey       String
  mode              String    @default("cache-first")
  revisionId        Int?
  revisionTimestamp DateTime?
  contentHash       String?
  lastGoodAt        DateTime?
  lastAttemptAt     DateTime?
  lastErrorClass    String?
  qualityScore      Float?
  cacheUntil        DateTime?
  staleUntil        DateTime?
  externalRequests  Int       @default(0)
  bytesIn           Int?
  bytesOut          Int?
  cacheLayer        String?
  rawSnapshotId     String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([source, disciplineSlug, resourceType, resourceKey, mode], map: "SourceFetchCache_source_disciplineSlug_resourceType_resourceKey")
  @@index([source, disciplineSlug, resourceType])
  @@index([cacheUntil])
  @@index([staleUntil])
  @@index([lastGoodAt])
}

model GlobalSettings {
  key   String @id
  value String @db.Text
}

model AdminLoginRateLimit {
  key             String   @id @db.VarChar(64)
  attempts        Int
  windowStartedAt DateTime
  expiresAt       DateTime

  @@index([expiresAt])
}

model ProxyPool {
  id            String    @id @default(cuid())
  url           String    @unique
  protocol      String    @default("http")
  host          String
  port          Int
  username      String?
  password      String?
  isActive      Boolean   @default(true)
  failCount     Int       @default(0)
  lastError     String?   @db.Text
  cooldownUntil DateTime?
  successCount  Int       @default(0)
  blockedCount  Int       @default(0)
  avgLatencyMs  Int?
  lastUsed      DateTime?
  createdAt     DateTime  @default(now())
}

model ParserRequestLog {
  id                  String   @id @default(cuid())
  source              String
  mode                String?
  route               String?
  disciplineSlug      String?
  queryHash           String?
  proxyId             String?
  attempt             Int?
  statusCode          Int?
  errorClass          String?
  durationMs          Int?
  bytesIn             Int?
  bytesOut            Int?
  cacheLayer          String?
  cacheHit            Boolean  @default(false)
  matchesCount        Int?
  eventsCount         Int?
  tlineRunId          String?
  tlineChampionshipId String?
  createdAt           DateTime @default(now())

  tlineRun          TLineRun?          @relation(fields: [tlineRunId], references: [id], onDelete: SetNull)
  tlineChampionship TLineChampionship? @relation(fields: [tlineChampionshipId], references: [id], onDelete: SetNull)

  @@index([source, mode, createdAt])
  @@index([disciplineSlug, createdAt])
  @@index([proxyId, createdAt])
  @@index([cacheHit, createdAt])
  @@index([tlineRunId, createdAt])
  @@index([tlineChampionshipId, createdAt])
}

enum MappingStatus {
  unmapped
  auto_mapped
  manual_mapped
  manual_unmapped
  ambiguous
  ignored
}

model AdminTeam {
  id               String   @id @default(cuid())
  disciplineSlug   String
  platformId       String
  platformName     String
  platformNameRu   String?
  platformNameEn   String?
  normalizedName   String
  normalizedNameRu String?
  normalizedNameEn String?
  sourceFileName   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tlineMappings      TLineTeamMapping[]
  tlineGlobalHeaders TLineGlobalHeaderAdminTeam[]

  @@index([disciplineSlug])
  @@index([normalizedName])
  @@index([normalizedNameRu])
  @@index([normalizedNameEn])
}

model TeamMapping {
  id                       String        @id @default(cuid())
  disciplineSlug           String        @default("counterstrike")
  liquipediaName           String
  liquipediaNormalizedName String?
  internalTeamId           String?
  platformId               String?
  canonicalName            String?
  confidenceScore          Float?
  matchMethod              String?
  status                   MappingStatus @default(unmapped)
  isManual                 Boolean       @default(false)
  isLockedFromAutoMapping  Boolean       @default(false)
  alias                    String?
  logoUrl                  String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@unique([disciplineSlug, liquipediaName])
  @@index([liquipediaName])
  @@index([platformId])
  @@index([alias])
}

model ManualImportTeamMapping {
  id                 String   @id @default(cuid())
  disciplineSlug     String
  adminSportId       String
  teamName           String
  normalizedTeamName String
  platformId         String
  canonicalName      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([disciplineSlug, adminSportId, normalizedTeamName], map: "ManualImportTeamMapping_disciplineSlug_adminSportId_normalizedT")
  @@index([disciplineSlug, adminSportId])
  @@index([platformId])
}

model DisciplineAdminSettings {
  id              String   @id @default(cuid())
  disciplineSlug  String   @unique
  apiUrl          String?
  adminSportId    String?
  adminMax        String?
  defaultShapkaId String?
  timezone        String   @default("Europe/Moscow")
  dateFormat      String   @default("DD.MM.YYYY HH:mm:ss")
  requestMode     String   @default("legacy_raw") // legacy_raw, urlencoded, multipart
  sslVerify       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TournamentAdminMapping {
  id                   String   @id @default(cuid())
  disciplineSlug       String
  tournamentId         String   @unique
  sourceTournamentId   String?
  sourceTournamentName String
  adminShapkaId        String?
  adminShapkaName      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([disciplineSlug])
}

model AdminUploadLog {
  id                  String   @id @default(cuid())
  disciplineSlug      String
  tournamentId        String
  apiUrl              String
  adminSportId        String?
  adminMax            String?
  adminShapkaId       String?
  requestMode         String
  timezone            String
  dateFormat          String
  payloadHash         String?
  phpArrayJson        Json
  serializedFixt      String   @db.Text
  readyMatchesCount   Int
  skippedMatchesCount Int
  skippedMatchesJson  Json
  responseRaw         String?  @db.Text
  responseParsedJson  Json?
  status              String   @default("pending") // success, success_like, failed, pending
  errorMessage        String?  @db.Text
  createdAt           DateTime @default(now())

  @@unique([disciplineSlug, tournamentId, payloadHash])
  @@index([disciplineSlug])
  @@index([tournamentId])
}

enum KhlMatchState {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  UNKNOWN
}

enum KhlBindingStatus {
  UNMAPPED
  SUGGESTED
  CONFIRMED
  REJECTED
  AMBIGUOUS
}

enum KhlBindingMode {
  AUTO
  MANUAL
}

enum KhlRevisionState {
  VALIDATED
  REJECTED
}

enum KhlSnapshotResource {
  BOOTSTRAP
  SCHEDULE
  EVENT_DETAIL
  PROTOCOL
}

enum KhlStatScope {
  TEAM
  PLAYER
}

enum KhlDeliveryState {
  PENDING
  IN_FLIGHT
  ACKNOWLEDGED
  FAILED
  UNKNOWN
}

model KhlTeam {
  id                 String           @id @default(cuid())
  khlTeamId          String           @unique
  apiTeamId          String?          @unique
  name               String
  location           String?
  logoUrl            String?
  adminTeamId        String?          @unique
  adminBindingStatus KhlBindingStatus @default(UNMAPPED)
  adminConfirmedAt   DateTime?
  adminConfirmedBy   String?
  firstSeenAt        DateTime         @default(now())
  lastSeenAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  homeMatches      KhlMatch[]            @relation("KhlHomeTeam")
  awayMatches      KhlMatch[]            @relation("KhlAwayTeam")
  participants     KhlMatchParticipant[]
  teamStatTargets  KhlTeamStatTarget[]
  teamStatBindings KhlTeamStatBinding[]

  @@index([apiTeamId])
  @@index([adminBindingStatus])
}

model KhlPlayer {
  id                 String           @id @default(cuid())
  khlPlayerId        String           @unique
  apiPlayerId        String?          @unique
  name               String
  role               String?
  adminPlayerId      String?          @unique
  adminBindingStatus KhlBindingStatus @default(UNMAPPED)
  adminConfirmedAt   DateTime?
  adminConfirmedBy   String?
  firstSeenAt        DateTime         @default(now())
  lastSeenAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  participants KhlMatchParticipant[]

  @@index([apiPlayerId])
  @@index([adminBindingStatus])
}

model KhlMatch {
  id                  String           @id @default(cuid())
  khlGameId           String           @unique
  apiEventId          String           @unique
  sourceMatchId       String           @unique
  stageId             String
  khlStageId          String
  stageName           String?
  season              String
  startsAt            DateTime
  status              KhlMatchState
  homeTeamId          String
  awayTeamId          String
  officialHomeScore   Int?
  officialAwayScore   Int?
  regulationHomeScore Int?
  regulationAwayScore Int?
  activeRevisionId    String?          @unique
  adminMatchId        String?          @unique
  adminBindingStatus  KhlBindingStatus @default(UNMAPPED)
  adminBindingMode    KhlBindingMode?
  adminConfirmedAt    DateTime?
  adminConfirmedBy    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  homeTeam        KhlTeam               @relation("KhlHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam        KhlTeam               @relation("KhlAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  activeRevision  KhlMatchRevision?     @relation("KhlActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  revisions       KhlMatchRevision[]    @relation("KhlMatchRevisions")
  rawSnapshots    KhlRawSnapshot[]
  participants    KhlMatchParticipant[]
  teamStatTargets KhlTeamStatTarget[]

  @@index([stageId, startsAt])
  @@index([khlStageId, startsAt])
  @@index([homeTeamId, awayTeamId, startsAt])
  @@index([adminBindingStatus])
}

model KhlRawSnapshot {
  id             String              @id @default(cuid())
  matchId        String?
  resourceType   KhlSnapshotResource
  externalKey    String
  sourceUrl      String              @db.Text
  contentType    String?
  contentHash    String              @db.Char(64)
  rawBody        Bytes
  firstFetchedAt DateTime
  lastFetchedAt  DateTime
  fetchCount     Int                 @default(1)
  createdAt      DateTime            @default(now())

  match     KhlMatch?          @relation(fields: [matchId], references: [id], onDelete: SetNull)
  revisions KhlMatchRevision[]

  @@unique([resourceType, externalKey, contentHash])
  @@index([matchId, lastFetchedAt])
  @@index([contentHash])
}

model KhlMatchRevision {
  id               String           @id @default(cuid())
  matchId          String
  snapshotId       String
  revisionNumber   Int
  normalizedHash   String           @db.Char(64)
  parserVersion    String
  rulesVersion     String
  state            KhlRevisionState
  normalizedJson   Json
  validationIssues Json
  createdAt        DateTime         @default(now())
  validatedAt      DateTime?

  match          KhlMatch       @relation("KhlMatchRevisions", fields: [matchId], references: [id], onDelete: Cascade)
  snapshot       KhlRawSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  activeForMatch KhlMatch?      @relation("KhlActiveRevision")
  deliveries     KhlDelivery[]

  @@unique([matchId, revisionNumber])
  @@unique([matchId, normalizedHash, parserVersion, rulesVersion])
  @@index([matchId, state, createdAt])
}

model KhlMatchParticipant {
  id                      String           @id @default(cuid())
  matchId                 String
  teamId                  String
  playerId                String
  shirtNumber             Int
  role                    String
  isListed                Boolean          @default(true)
  adminMatchPlayerId      String?          @unique
  adminBindingStatus      KhlBindingStatus @default(UNMAPPED)
  adminConfirmedAt        DateTime?
  adminConfirmedBy        String?
  firstSeenRevisionNumber Int
  lastSeenRevisionNumber  Int
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  match             KhlMatch              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team              KhlTeam               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  player            KhlPlayer             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerStatTargets KhlPlayerStatTarget[]

  @@unique([matchId, playerId])
  @@index([matchId, teamId, isListed])
  @@index([adminBindingStatus])
}

model KhlStatMapping {
  id                 String           @id @default(cuid())
  scope              KhlStatScope
  semanticCode       String
  adminStatTypeId    String?
  adminBindingStatus KhlBindingStatus @default(UNMAPPED)
  adminConfirmedAt   DateTime?
  adminConfirmedBy   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  teamTargets   KhlTeamStatTarget[]
  teamBindings  KhlTeamStatBinding[]
  playerTargets KhlPlayerStatTarget[]

  @@unique([scope, semanticCode])
  @@unique([scope, adminStatTypeId])
  @@index([adminBindingStatus])
}

model KhlTeamStatTarget {
  id                 String           @id @default(cuid())
  matchId            String
  teamId             String
  statMappingId      String
  adminMatchStatId   String?          @unique
  adminBindingStatus KhlBindingStatus @default(UNMAPPED)
  adminConfirmedAt   DateTime?
  adminConfirmedBy   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  match       KhlMatch       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team        KhlTeam        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  statMapping KhlStatMapping @relation(fields: [statMappingId], references: [id], onDelete: Restrict)

  @@unique([matchId, teamId, statMappingId])
  @@index([adminBindingStatus])
}

model KhlTeamStatBinding {
  id                 String           @id @default(cuid())
  teamId             String
  statMappingId      String
  adminTeamStatId    String?          @unique
  adminBindingStatus KhlBindingStatus @default(UNMAPPED)
  adminConfirmedAt   DateTime?
  adminConfirmedBy   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  team        KhlTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  statMapping KhlStatMapping @relation(fields: [statMappingId], references: [id], onDelete: Restrict)

  @@unique([teamId, statMappingId])
  @@index([adminBindingStatus])
}

model KhlPlayerStatTarget {
  id                 String           @id @default(cuid())
  participantId      String
  statMappingId      String
  adminPlayerStatId  String?          @unique
  adminBindingStatus KhlBindingStatus @default(UNMAPPED)
  adminConfirmedAt   DateTime?
  adminConfirmedBy   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  participant KhlMatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  statMapping KhlStatMapping      @relation(fields: [statMappingId], references: [id], onDelete: Restrict)

  @@unique([participantId, statMappingId])
  @@index([adminBindingStatus])
}

model KhlDelivery {
  id              String           @id @default(cuid())
  revisionId      String
  adminMatchId    String
  endpointVersion String
  payloadHash     String           @db.Char(64)
  idempotencyKey  String           @unique @db.Char(64)
  payloadJson     Json
  state           KhlDeliveryState @default(PENDING)
  leaseToken      String?
  leaseUntil      DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  revision KhlMatchRevision     @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  attempts KhlDeliveryAttempt[]

  @@unique([revisionId, adminMatchId, endpointVersion, payloadHash])
  @@index([state, leaseUntil])
}

model KhlDeliveryAttempt {
  id              String           @id @default(cuid())
  deliveryId      String
  attemptNumber   Int
  state           KhlDeliveryState
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  httpStatus      Int?
  responseHash    String?          @db.Char(64)
  responseExcerpt String?          @db.Text
  errorClass      String?
  errorMessage    String?          @db.Text
  createdAt       DateTime         @default(now())

  delivery KhlDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([state, startedAt])
}

enum TLineRunTrigger {
  MANUAL
  SCHEDULED
}

enum TLineRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  CANCELLED
  FAILED
}

enum TLineJobType {
  RUN_CHECK
  RETENTION_CLEANUP
}

enum TLineJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  CANCELLED
  FAILED
}

enum TLineMappingStatus {
  UNMAPPED
  SUGGESTED
  AUTO_MAPPED
  MANUAL_MAPPED
  MANUAL_UNMAPPED
  AMBIGUOUS
  EXCLUDED
}

enum TLineAutomaticStatus {
  PENDING
  PROCESSING
  AUTO_OK
  TIME_WARNING
  TIME_ERROR
  TIME_CRITICAL
  SOURCE_ONLY
  ADMIN_ONLY
  TEAM_UNMAPPED
  MATCH_AMBIGUOUS
  DUPLICATE_SOURCE
  DUPLICATE_ADMIN
  SOURCE_TIME_UNDEFINED
  STATUS_MISMATCH
  PARSER_FAILED
  CANCELLED
}

enum TLineEffectiveStatus {
  PENDING
  PROCESSING
  AUTO_OK
  TIME_WARNING
  TIME_ERROR
  TIME_CRITICAL
  SOURCE_ONLY
  ADMIN_ONLY
  TEAM_UNMAPPED
  MATCH_AMBIGUOUS
  DUPLICATE_SOURCE
  DUPLICATE_ADMIN
  SOURCE_TIME_UNDEFINED
  STATUS_MISMATCH
  PARSER_FAILED
  CANCELLED
  MANUAL_OK
  MANUAL_ERROR
  IGNORED
}

enum TLineSeverity {
  OK
  WARNING
  ERROR
  CRITICAL
  UNPROCESSED
}

enum TLineManualDecisionType {
  MANUAL_OK
  MANUAL_ERROR
  CONFIRM_CHAMPIONSHIP
  MANUAL_LINK
  IGNORE_UNTIL
  EXCLUDE
  RESET
}

enum TLineExceptionType {
  IGNORE_UNTIL
  EXCLUDE
}

model TLineSportConfig {
  id                             String    @id @default(cuid())
  disciplineId                   String    @unique
  adminSportId                   String?
  active                         Boolean   @default(true)
  autoEnabled                    Boolean   @default(false)
  autoPeriodFromOffsetMinutes    Int?
  autoPeriodToOffsetMinutes      Int?
  candidateMatchWindowMinutes    Int?
  defaultAllowedTimeDriftMinutes Int?
  lastSuccessAt                  DateTime?
  lastErrorAt                    DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  discipline    Discipline          @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  globalHeaders TLineGlobalHeader[]
  championships TLineChampionship[]
  runs          TLineRun[]
  jobs          TLineJob[]

  @@index([active, autoEnabled])
}

model TLineGlobalHeader {
  id            String   @id @default(cuid())
  sportConfigId String
  adminShapkaId String
  name          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sportConfig   TLineSportConfig             @relation(fields: [sportConfigId], references: [id], onDelete: Restrict)
  championships TLineChampionship[]
  adminTeams    TLineGlobalHeaderAdminTeam[]

  @@unique([sportConfigId, adminShapkaId])
  @@index([sportConfigId, active])
}

model TLineChampionship {
  id                          String    @id @default(cuid())
  sportConfigId               String
  globalHeaderId              String?
  name                        String
  season                      String?
  sourceProvider              String
  sourceUrl                   String    @db.Text
  sourceChampionshipId        String?
  adminChampionshipId         String?
  adminChampionshipName       String?
  sourceTimezone              String    @default("Europe/Moscow")
  active                      Boolean   @default(true)
  autoEnabled                 Boolean   @default(false)
  allowedTimeDriftMinutes     Int?
  candidateMatchWindowMinutes Int?
  lastSuccessAt               DateTime?
  lastErrorAt                 DateTime?
  deletedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  sportConfig       TLineSportConfig           @relation(fields: [sportConfigId], references: [id], onDelete: Restrict)
  globalHeader      TLineGlobalHeader?         @relation(fields: [globalHeaderId], references: [id], onDelete: Restrict)
  sourceTeams       TLineSourceTeam[]
  teamMappings      TLineTeamMapping[]
  runChampionships  TLineRunChampionship[]
  persistentLinks   TLinePersistentMatchLink[]
  exceptions        TLineException[]
  parserRequestLogs ParserRequestLog[]

  @@unique([sportConfigId, sourceProvider, sourceUrl])
  @@index([sportConfigId, active, autoEnabled])
  @@index([globalHeaderId])
  @@index([adminChampionshipId])
}

model TLineGlobalHeaderAdminTeam {
  globalHeaderId  String
  adminTeamId     String
  sourceFileName  String?
  firstImportedAt DateTime @default(now())
  lastImportedAt  DateTime @default(now())

  globalHeader TLineGlobalHeader @relation(fields: [globalHeaderId], references: [id], onDelete: Restrict)
  adminTeam    AdminTeam         @relation(fields: [adminTeamId], references: [id], onDelete: Restrict)

  @@id([globalHeaderId, adminTeamId])
  @@index([adminTeamId])
}

model TLineSourceTeam {
  id             String   @id @default(cuid())
  championshipId String
  externalId     String?
  name           String
  normalizedName String
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  championship TLineChampionship @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  mapping      TLineTeamMapping?

  @@unique([championshipId, externalId])
  @@unique([id, championshipId])
  @@index([championshipId, normalizedName])
  @@index([championshipId, lastSeenAt])
}

model TLineTeamMapping {
  id              String             @id @default(cuid())
  championshipId  String
  sourceTeamId    String             @unique
  adminTeamId     String
  status          TLineMappingStatus @default(UNMAPPED)
  confidenceScore Float?
  matchMethod     String?
  alias           String?
  isLocked        Boolean            @default(false)
  confirmedAt     DateTime?
  confirmedBy     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  championship TLineChampionship @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  sourceTeam   TLineSourceTeam   @relation(fields: [sourceTeamId, championshipId], references: [id, championshipId], onDelete: Restrict)
  adminTeam    AdminTeam         @relation(fields: [adminTeamId], references: [id], onDelete: Restrict)

  @@unique([sourceTeamId, championshipId])
  @@index([championshipId, status])
  @@index([adminTeamId])
}

model TLineRun {
  id                String          @id @default(cuid())
  sportConfigId     String
  trigger           TLineRunTrigger
  status            TLineRunStatus  @default(QUEUED)
  periodFrom        DateTime
  periodTo          DateTime
  scheduledAt       DateTime?
  progressTotal     Int             @default(0)
  progressProcessed Int             @default(0)
  okCount           Int             @default(0)
  warningCount      Int             @default(0)
  errorCount        Int             @default(0)
  criticalCount     Int             @default(0)
  unprocessedCount  Int             @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  errorCode         String?
  errorMessage      String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sportConfig       TLineSportConfig       @relation(fields: [sportConfigId], references: [id], onDelete: Restrict)
  runChampionships  TLineRunChampionship[]
  job               TLineJob?
  parserRequestLogs ParserRequestLog[]

  @@unique([sportConfigId, scheduledAt])
  @@index([sportConfigId, status, createdAt])
  @@index([status, createdAt])
}

model TLineRunChampionship {
  id                String                @id @default(cuid())
  runId             String
  championshipId    String
  status            TLineRunStatus        @default(QUEUED)
  automaticStatus   TLineAutomaticStatus  @default(PENDING)
  manualStatus      TLineEffectiveStatus?
  effectiveStatus   TLineEffectiveStatus  @default(PENDING)
  severity          TLineSeverity         @default(UNPROCESSED)
  effectiveSeverity TLineSeverity         @default(UNPROCESSED)
  reasonCodes       Json
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  run             TLineRun                   @relation(fields: [runId], references: [id], onDelete: Cascade)
  championship    TLineChampionship          @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  sourceSnapshots TLineSourceMatchSnapshot[]
  adminSnapshots  TLineAdminMatchSnapshot[]
  comparisons     TLineComparison[]
  manualDecisions TLineManualDecision[]

  @@unique([runId, championshipId])
  @@index([championshipId, createdAt])
  @@index([runId, status])
}

model TLineSourceMatchSnapshot {
  id                 String    @id @default(cuid())
  runChampionshipId  String
  sourceKey          String
  occurrenceIndex    Int       @default(0)
  externalMatchId    String?
  sourceUrl          String?   @db.Text
  homeExternalTeamId String?
  awayExternalTeamId String?
  homeTeamName       String
  awayTeamName       String
  originalTimeText   String?
  sourceTimezone     String
  scheduledAtUtc     DateTime?
  sourceStatus       String?
  rawPayload         Json
  createdAt          DateTime  @default(now())

  runChampionship TLineRunChampionship @relation(fields: [runChampionshipId], references: [id], onDelete: Cascade)
  comparison      TLineComparison?

  @@unique([runChampionshipId, sourceKey, occurrenceIndex])
  @@index([runChampionshipId, scheduledAtUtc])
  @@index([externalMatchId])
}

model TLineAdminMatchSnapshot {
  id                      String    @id @default(cuid())
  runChampionshipId       String
  adminMatchId            String
  occurrenceIndex         Int       @default(0)
  homeAdminTeamPlatformId String?
  awayAdminTeamPlatformId String?
  homeTeamName            String
  awayTeamName            String
  originalTimeText        String?
  scheduledAtUtc          DateTime?
  adminStatus             String?
  rawPayload              Json
  createdAt               DateTime  @default(now())

  runChampionship TLineRunChampionship @relation(fields: [runChampionshipId], references: [id], onDelete: Cascade)
  comparison      TLineComparison?

  @@unique([runChampionshipId, adminMatchId, occurrenceIndex])
  @@index([runChampionshipId, scheduledAtUtc])
}

model TLineComparison {
  id                String                @id @default(cuid())
  runChampionshipId String
  sourceSnapshotId  String?               @unique
  adminSnapshotId   String?               @unique
  pairKey           String?
  automaticStatus   TLineAutomaticStatus
  manualStatus      TLineEffectiveStatus?
  effectiveStatus   TLineEffectiveStatus
  severity          TLineSeverity
  effectiveSeverity TLineSeverity
  reasonCodes       Json
  swappedSides      Boolean               @default(false)
  timeDeltaMinutes  Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  runChampionship TLineRunChampionship      @relation(fields: [runChampionshipId], references: [id], onDelete: Cascade)
  sourceSnapshot  TLineSourceMatchSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  adminSnapshot   TLineAdminMatchSnapshot?  @relation(fields: [adminSnapshotId], references: [id], onDelete: Restrict)
  manualDecisions TLineManualDecision[]

  @@index([runChampionshipId, effectiveStatus])
  @@index([pairKey])
}

model TLineManualDecision {
  id                String                  @id @default(cuid())
  runChampionshipId String?
  comparisonId      String?
  decisionType      TLineManualDecisionType
  effectiveStatus   TLineEffectiveStatus?
  persistent        Boolean                 @default(false)
  actorId           String?
  note              String?                 @db.Text
  expiresAt         DateTime?
  createdAt         DateTime                @default(now())

  runChampionship TLineRunChampionship? @relation(fields: [runChampionshipId], references: [id], onDelete: Restrict)
  comparison      TLineComparison?      @relation(fields: [comparisonId], references: [id], onDelete: Restrict)

  @@index([runChampionshipId, createdAt])
  @@index([comparisonId, createdAt])
  @@index([actorId, createdAt])
}

model TLinePersistentMatchLink {
  id             String   @id @default(cuid())
  championshipId String
  sourceMatchKey String
  adminMatchId   String
  active         Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  championship TLineChampionship @relation(fields: [championshipId], references: [id], onDelete: Restrict)

  @@unique([championshipId, sourceMatchKey])
  @@index([championshipId, adminMatchId])
}

model TLineException {
  id             String             @id @default(cuid())
  championshipId String
  type           TLineExceptionType
  sourceMatchKey String?
  adminMatchId   String?
  reason         String?            @db.Text
  expiresAt      DateTime?
  active         Boolean            @default(true)
  createdBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  championship TLineChampionship @relation(fields: [championshipId], references: [id], onDelete: Restrict)

  @@index([championshipId, type, active])
  @@index([expiresAt])
}

model TLineJob {
  id                String         @id @default(cuid())
  sportConfigId     String?
  runId             String?        @unique
  type              TLineJobType
  status            TLineJobStatus @default(QUEUED)
  idempotencyKey    String         @unique
  scheduledAt       DateTime?
  availableAt       DateTime       @default(now())
  priority          Int            @default(0)
  payload           Json
  attempts          Int            @default(0)
  maxAttempts       Int            @default(3)
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sportConfig TLineSportConfig? @relation(fields: [sportConfigId], references: [id], onDelete: Restrict)
  run         TLineRun?         @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([sportConfigId, scheduledAt, type])
  @@index([status, availableAt, priority])
  @@index([status, leaseExpiresAt])
}

model TLineScheduleState {
  id         String    @id @default("global")
  enabled    Boolean   @default(false)
  timezone   String    @default("Europe/Moscow")
  slotHours  Int[]     @default([8, 12, 16, 22])
  lastTickAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
